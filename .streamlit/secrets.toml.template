# .streamlit/secrets.toml
# Googleアカウントでログインするための設定テンプレート
# このファイルを secrets.toml にコピーして、自身のGoogle Client IDとClient Secretを記入してください。

GEMINI_API_KEY = "your-gemini-api-key-here"

[auth]
# ローカル起動時のリダイレクトURI（Google Cloud Consoleの承認済みのリダイレクトURIと完全一致させる必要があります）
redirect_uri = "http://localhost:8501/oauth2callback"

# セッションCookie暗号化用のランダムな文字列（任意の英数字32文字以上を推奨）
cookie_secret = "change-this-to-a-random-secret-key-1234567890"

# Google Cloud Console で作成した OAuth 2.0 クライアントID
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Google Cloud Console で作成した OAuth 2.0 クライアントシークレット
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

# Google OpenID Connect メタデータURL（通常このままでOK）
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
